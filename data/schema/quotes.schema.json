{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quotes.schema.json",
  "title": "견적",
  "description": "견적 1건. 공통 필드 + 사업부별 조건(conditions)·항목(items)을 JSON으로 담는 '공통 + 사업부 확장' 구조.",
  "type": "object",
  "x-table": "quotes",
  "x-idPrefix": "quo",
  "x-airtable": { "table": "견적", "base": "division", "primaryField": "quoteNo", "jsonFields": ["conditions", "items", "files"] },
  "x-links": { "customerId": "customers", "buildingId": "buildings", "templateVersionId": "templateVersions" },
  "required": ["id", "quoteNo", "divisionId", "buildingId", "conditions", "items", "subtotal", "vat", "total", "pricingSource", "status", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(stg_)?quo_[0-9a-z]+$" },
    "quoteNo": { "type": "string", "pattern": "^GW-[A-Z]{2,6}-[0-9]{8}-[0-9]{3,}$", "description": "GW-{사업부코드}-{YYYYMMDD}-{일련번호}" },
    "divisionId": { "type": "string", "description": "→ divisions.id" },
    "customerId": { "type": ["string", "null"], "description": "→ customers.id" },
    "buildingId": { "type": "string", "description": "→ buildings.id" },
    "conditions": { "type": "object", "description": "사업부 config.inputs 값 (예: fire {grade}, mechanical {boilers, cycle…})" },
    "items": { "type": "array", "description": "[{code, name, basis, amount}] 산출 항목" },
    "subtotal": { "type": "integer", "description": "공급가액(원)" },
    "vat": { "type": "integer" },
    "total": { "type": "integer", "description": "합계(원, VAT 포함)" },
    "pricingSource": { "type": "string", "enum": ["store", "cache", "fallback"], "description": "계산에 쓴 단가의 출처" },
    "pricingVersion": { "type": ["string", "null"] },
    "templateVersionId": { "type": ["string", "null"], "description": "→ templateVersions.id (생성 스크립트로 만든 과거 견적은 null)" },
    "templateVersion": { "type": ["integer", "null"] },
    "files": { "type": ["object", "null"], "description": "{xlsx, pdf} 저장소 기준 상대 경로" },
    "pdfStatus": { "type": ["string", "null"], "enum": ["ok", "skipped", "circuit-open", "failed", null] },
    "status": { "type": "string", "enum": ["draft", "sent", "won", "lost"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
