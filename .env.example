# .env.example — 복사해서 .env 로 쓴다(.env는 커밋 금지).
# 값이 비어 있으면 가짜 모드(fake)로 실행된다. 키 없이 모든 데모가 돈다.

# fake | live  (live여도 키가 없으면 해당 기능만 가짜 응답으로 동작)
DEMO_MODE=fake

# ---- 데이터 저장소 ----
# local | airtable
STORE_ADAPTER=local
# production | staging  (staging이면 ID 매핑 가드가 켜진다)
STORE_TARGET=production
AIRTABLE_TOKEN=
# Base 하나에 7개 테이블을 둔 구성
AIRTABLE_BASE_ID=
# 허브 + 사업부 Base 구성(airtable/schema/gridwell.yaml). 허브 ID가 있으면 이 구성을 쓴다.
AIRTABLE_HUB_BASE_ID=
AIRTABLE_BASE_ID_FIRE=
AIRTABLE_BASE_ID_TELECOM=
AIRTABLE_BASE_ID_MECHANICAL=

# ---- 공공 API (선택) ----
# 도로명주소 검색 API 승인키
JUSO_API_KEY=
# 공공데이터포털 건축물대장(건축HUB) 서비스키
BUILDING_REGISTER_API_KEY=

# ---- PDF 변환 (선택) ----
# 비우면 기본 설치 경로·PATH에서 찾는다. 없으면 xlsx만 만든다.
SOFFICE_PATH=
PDF_TIMEOUT_MS=90000

# ---- 오류 알림 (선택) ----
# 디스코드 웹훅 형식. 비우면 콘솔에만 남긴다.
ERROR_WEBHOOK_URL=
# 있으면 오류 요약에 LLM을 쓴다(선택). 없으면 규칙 기반 요약.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PORT=3000
