      "versionNonce": 869340623,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "원본이 이상하면 멈추고, 한 건의 실패는 그 건만 건너뛴다. 판정 코드는 에어테이블 스크립트와 n8n이 같다(lib/sync-core.js)",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13.12,
      "containerId": null,
      "originalText": "원본이 이상하면 멈추고, 한 건의 실패는 그 건만 건너뛴다. 판정 코드는 에어테이블 스크립트와 n8n이 같다(lib/sync-core.js)",
      "lineHeight": 1.25
    }
